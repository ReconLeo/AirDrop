# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---------- 运行时数据（首次启动自动生成，无需提交） ----------
# 独立应用
standalone/uploads/          # 用户上传的文件
uploads/
logs/
output/
backup/
temp/

# 灵犀会话工作区残留
.lingxi/
.rundata/
.test/

# 遗留本地归档（README.docx 源文档 / 框架签名验证报告，不入库）
docs/_legacy/

# 插件发布签名私钥（公钥 keys/*_public.pem 提交，私钥绝不入库）
keys/*private*.pem
keys/private.pem

# 插件打包构建产物（dist/ 由 tools/build_package.py 从 plugin/ 组装生成）
dist/

# ---------- Node.js（前端 jsdom 测试等，临时安装不入库） ----------
node_modules/

# ---------- 操作系统 / 编辑器 ----------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
workspace/
